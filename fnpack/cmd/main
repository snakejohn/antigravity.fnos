#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

LIB_TYPE="${wizard_data_library_type:-data}"
if [ "${LIB_TYPE}" = "data" ]; then
    DATA_LIBRARY_PATH="${TRIM_PKGVAR}"
else
    DATA_LIBRARY_PATH="${TRIM_DATA_SHARE_PATHS%%:*}"
fi

AGY_RUN_USER="${wizard_agy_run_user:-root}"
[ "${AGY_RUN_USER}" = "package" ] && AGY_RUN_USER="antigravity.harness"

export DATA_LIBRARY_PATH="${DATA_LIBRARY_PATH}"
export AGY_RUN_USER="${AGY_RUN_USER}"
export TRIM_APPDEST="${TRIM_APPDEST}"
export TRIM_APPVER="${TRIM_APPVER:-1.0.0}"

CMD="${TRIM_APPDEST}/bin/antigravity.harness"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi
    mkdir -p "${DATA_LIBRARY_PATH}"
    log_msg "Starting antigravity.harness (CMD=${CMD}, DATA=${DATA_LIBRARY_PATH})..."
    if [ "${AGY_RUN_USER}" != "root" ] && id "${AGY_RUN_USER}" >/dev/null 2>&1; then
        su -s /bin/bash "${AGY_RUN_USER}" -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    else
        "${CMD}" >> "${LOG_FILE}" 2>&1 &
    fi
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    sleep 1
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 1
    fi
    return 0
}

stop_process() {
    log_msg "Stopping antigravity.harness..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while check_process "${pid}" && [ $count -lt 5 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    rm -f "${TRIM_APPDEST}/web.sock"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
